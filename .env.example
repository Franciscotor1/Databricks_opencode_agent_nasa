# Configuración de credenciales y entorno para Databricks Opencode Agent
# Copiar este archivo a .env y ajustar los valores con permisos 600

# Clave API de Google para Gemini 3.5 Flash-Lite
GEMINI_API_KEY=your_gemini_api_key_here

# Databricks Workspace Config
DATABRICKS_HOST=your-workspace-id.cloud.databricks.com
DATABRICKS_TOKEN=dapipat_your_personal_access_token_here

# Contraseña de acceso al agente
AGENT_PASSWORD=databricks2026
