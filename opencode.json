{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.5-flash-lite",
  "small_model": "google/gemini-3.5-flash-lite",
  "provider": {
    "google": {
      "apiKey": {
        "env": "GEMINI_API_KEY"
      }
    }
  },
  "plugin": [],
  "mcp": {
    "databricks-sql": {
      "type": "http",
      "url": "https://${DATABRICKS_HOST}/api/2.0/mcp/sql",
      "headers": {
        "Authorization": "Bearer ${DATABRICKS_TOKEN}"
      },
      "enabled": true
    },
    "databricks-functions": {
      "type": "http",
      "url": "https://${DATABRICKS_HOST}/api/2.0/mcp/functions/main/default",
      "headers": {
        "Authorization": "Bearer ${DATABRICKS_TOKEN}"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com",
      "enabled": true
    }
  },
  "skills": {
    "paths": [
      "./skills/databricks-core",
      "./skills/databricks-apps",
      "./skills/databricks-pipelines",
      "./skills/databricks-dabs",
      "./skills/databricks-model-serving",
      "./skills/databricks-vector-search",
      "./skills/databricks-serverless-migration",
      "./skills/databricks-unity-catalog"
    ]
  },
  "permission": {
    "edit": "ask",
    "bash": "ask"
  }
}
